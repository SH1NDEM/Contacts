<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" Height="450" Width="800
        " ResizeMode="NoResize">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="142"/>
            <ColumnDefinition Width="282*"/>
        </Grid.ColumnDefinitions>

        <!-- ПРАВАЯ ПАНЕЛЬ — Read Contact -->
        <GroupBox Grid.Column="1" Margin="10,10,10,0" Grid.ColumnSpan="3">
            <StackPanel Margin="140,0,10,0" VerticalAlignment="Top">
                <!-- Name -->
                <Label Content="Name:"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Phone Number:"/>
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Email:"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>
        </GroupBox>

        <!-- КНОПКИ Save -->
        <StackPanel Grid.Column="3" Margin="0,177,0,0" RenderTransformOrigin="0,0.5" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Width="75">
            <Button Content="Apply" Command="{Binding SaveCommand}" Height="25" Width="75"/>
        </StackPanel>
        <Image Height="120" Margin="0,22,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="120" Grid.Column="2" Source="/photo_2025-08-08_01-45-12.jpg"/>
        <ListBox Height="359" Margin="0,10,0,0" VerticalAlignment="Top" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <StackPanel HorizontalAlignment="Left" Height="30" Margin="0,374,0,0" VerticalAlignment="Top" Width="235" Orientation="Horizontal">
            <Button Content="Apply" Command="{Binding SaveCommand}" Margin="0,0,5,0" Width="75"/>
            <Button Content="Apply" Command="{Binding SaveCommand}" Margin="0,0,5,0" Width="75"/>
            <Button Content="Apply" Command="{Binding SaveCommand}" Margin="0,0,5,0" Width="75"/>
        </StackPanel>


    </Grid>
</Window>
