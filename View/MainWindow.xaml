<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" Height="450" Width="510">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="24*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ — Edit Contact -->
        <GroupBox Header="Edit Contact" Grid.Column="0" Margin="0,10,0,0">
            <StackPanel Margin="10" VerticalAlignment="Top">
                <!-- Name -->
                <Label Content="Name:"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="20"/>

                <!-- Phone -->
                <Label Content="Phone Number:"/>
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="20"/>

                <!-- Email -->
                <Label Content="Email:"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="20"/>
            </StackPanel>
        </GroupBox>

        <!-- ПРАВАЯ ПАНЕЛЬ — Read Contact -->
        <GroupBox Header="Read Contact" Grid.Column="2" Margin="0,10,0,0">
            <StackPanel Margin="10" VerticalAlignment="Top">
                <!-- Name -->
                <Label Content="Name:"/>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,0,10" Height="20"/>

                <!-- Phone -->
                <Label Content="Phone Number:"/>
                <TextBlock Text="{Binding PhoneNumber}" FontWeight="Bold" Margin="0,0,0,10" Height="20"/>

                <!-- Email -->
                <Label Content="Email:"/>
                <TextBlock Text="{Binding Email}" FontWeight="Bold" Margin="0,0,0,10" Height="20"/>
            </StackPanel>
        </GroupBox>

        <!-- КНОПКИ Save / Load -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="50,351,0,0">
            <Button Content="Save" Width="75" Height="25" Command="{Binding SaveCommand}" Margin="0,0,10,0"/>
            <Button Content="Load" Width="75" Height="25" Command="{Binding LoadCommand}"/>
        </StackPanel>

    </Grid>
</Window>
