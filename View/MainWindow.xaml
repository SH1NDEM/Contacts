<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" Height="450" Width="800
        " ResizeMode="NoResize">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="142"/>
            <ColumnDefinition Width="282*"/>
        </Grid.ColumnDefinitions>

        <!-- ПРАВАЯ ПАНЕЛЬ — Read Contact -->

        <StackPanel Margin="0,10,0,0" VerticalAlignment="Top" Grid.Column="3">
            <!-- Name -->
            <Label Content="Name:"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Phone Number:"/>
            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Email:"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        </StackPanel>


        <!-- КНОПКИ Save -->
        <StackPanel Grid.Column="3" Margin="0,177,0,0" RenderTransformOrigin="0,0.5" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Width="75">
            <Button Content="Apply" Command="{Binding SaveCommand}" Height="25" Width="75"/>
        </StackPanel>
        <Image Height="120" Margin="0,22,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="120" Grid.Column="2" Source="/photo_2025-08-08_01-45-12.jpg"/>
        <ListBox Margin="0,27,0,34"/>
        <StackPanel HorizontalAlignment="Right" Width="240" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" Grid.ColumnSpan="2" Margin="0,0,10,0">
            <Button Content="Add" Command="{Binding SaveCommand}" Margin="0,0,5,0" Width="75" Height="25"/>
            <Button Content="Edit" Command="{Binding SaveCommand}" Margin="0,0,5,0" Width="75" Height="25"/>
            <Button Content="Remove" Command="{Binding SaveCommand}" Margin="0,0,0,0" Width="75" Height="25"/>
        </StackPanel>
        <TextBox HorizontalAlignment="Left" Margin="35,4,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200"/>
        <Label Content="Find:" Grid.Column="0" HorizontalAlignment="Left" Width="60" Height="26" VerticalAlignment="Top"/>


    </Grid>
</Window>
