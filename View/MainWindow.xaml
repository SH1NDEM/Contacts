<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" Height="450" Width="800"
        ResizeMode="NoResize" Icon="/ContactIcon.jpg">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="250" MaxWidth="430"/>
            <!-- Левая панель -->
            <ColumnDefinition Width="5"/>
            <!-- Сплиттер -->
            <ColumnDefinition/>
            <!-- Правая панель -->
        </Grid.ColumnDefinitions>

        <!-- ============= ЛЕВАЯ ПАНЕЛЬ ============= -->
        <Grid Grid.Column="0" Background="#f8f8f8" Margin="-15,-14,0,-14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поиск -->
            <Grid Margin="15,15,15,0" Height="20" VerticalAlignment="Top" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Find:" VerticalAlignment="Center" Height="25"/>

                <TextBox Grid.Column="1"
             Margin="5,0,0,0"
             VerticalAlignment="Center"/>
            </Grid>


            <!-- Список контактов -->
            <ListBox Grid.Row="1"
                     Name="Name_ListBox"
                     ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact}"
                     Margin="15,46,15,40" 
                     SelectionChanged="Name_ListBox_SelectionChanged"
                     DisplayMemberPath="Name"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Height="25" VerticalAlignment="Bottom" Margin="15,0,15,10">
                <Button Content="Add" 
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                        Name="Add_Button"
                        Width="75" 
                        Margin="0,0,5,0" 
                        Click="Add_Button_Click"/>
                <Button Content="Edit" 
                        IsEnabled ="False"
                        Name="Edit_Button"
                        Width="75" 
                        Margin="0,0,5,0" 
                        Click="Edit_Button_Click"/>
                <Button Content="Remove" 
                        IsEnabled ="False"
                        Name="Remove_Button"
                        Width="75" 
                        Click="Remove_Button_Click"/>
            </StackPanel>
        </Grid>

        <!-- ============= СПЛИТТЕР ============= -->
        <GridSplitter
                      HorizontalAlignment="Stretch"
                      Background="#FFFFFF" Grid.Column="1"/>

        <!-- ============= ПРАВАЯ ПАНЕЛЬ ============= -->
        <Grid Grid.Column="2" Margin="10,0,0,-14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Фото -->
            <Image 
                Source="/Peson.jpg" 
                Margin="25,40,0,0" 
                Grid.RowSpan="2" 
                Height="100" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Left" Width="100"/>

            <!-- Поля контакта -->
            <StackPanel Margin="159,10,0,0" 
                        Grid.RowSpan="2" 
                        Height="139" 
                        VerticalAlignment="Top" >

                <Label Content="Name:"/>
                <TextBox Text="{Binding SelectedContact.Name}"
                         Name="Name_TextBox"
                         IsReadOnly="True"/>

                <Label Content="Phone Number:"/>
                <TextBox Text="{Binding SelectedContact.PhoneNumber}"
                         Name="PhoneNumber_TextBox"
                         IsReadOnly="True"/>

                <Label Content="Email:"/>
                <TextBox Text="{Binding SelectedContact.Email}"
                         Name="Email_TextBox"
                         IsReadOnly="True"/>
            </StackPanel>

            <!-- Apply (скрыт по умолчанию) -->
            <Button Content="Apply"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                    Name="Apply_Button"
                    Grid.Row="1"
                    Width="75" Height="25"
                    HorizontalAlignment="Left"
                    Command="{Binding ApplyCommand}"
                    Click="Apply_Button_Click"
                    Margin="159,0,0,209" VerticalAlignment="Bottom"/>
        </Grid>
        <StackPanel Grid.Column="2"/>
    </Grid>
</Window>
