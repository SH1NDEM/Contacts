<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:View.Controls"
        Title="Contacts" Height="450" Width="800"
        MinWidth="600" MinHeight="300"
        ResizeMode="CanResize" Icon="/ContactIcon.jpg">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="250" MaxWidth="500"/>
            <!-- Левая панель -->
            <ColumnDefinition Width="5"/>
            <!-- Сплиттер -->
            <ColumnDefinition/>
            <!-- Правая панель -->
        </Grid.ColumnDefinitions>

        <!-- ============= ЛЕВАЯ ПАНЕЛЬ ============= -->
        <Grid Grid.Column="0" Background="#f8f8f8" Margin="-15,-14,0,-14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поиск -->
            <Grid Margin="15,15,15,0" Height="20" VerticalAlignment="Top" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Find:" VerticalAlignment="Center" Height="25"/>

                <TextBox Grid.Column="1"
             Margin="5,0,0,0"
             VerticalAlignment="Center"/>
            </Grid>


            <!-- Список контактов -->
            <ListBox Grid.Row="1"
         Name="Name_ListBox"
         ItemsSource="{Binding Contacts}"
         SelectedItem="{Binding SelectedContact}"
         Margin="15,46,15,40">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="3">
                            <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"/>
                            <TextBlock
                    FontSize="10"
                    Text="{Binding PhoneNumber}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center" Width="235" Height="25" VerticalAlignment="Bottom">
                <Button Content="Add" 
                        Visibility="Visible"
                        Name="Add_Button"
                        Width="75" 
                        Margin="0,0,5,0" 
                        Command="{Binding AddContact}"/>
                <Button Content="Edit" 
                        Name="Edit_Button"
                        Width="75" 
                        Margin="0,0,5,0" 
                        Command="{Binding EditContact}"/>
                <Button Content="Remove" 
                        Name="Remove_Button"
                        Width="75" 
                        Command="{Binding RemoveContact}"/>
            </StackPanel>
        </Grid>

        <!-- ============= СПЛИТТЕР ============= -->
        <GridSplitter
                      HorizontalAlignment="Stretch"
                      Background="#FFFFFF" Grid.Column="1"/>

        <!-- ============= ПРАВАЯ ПАНЕЛЬ ============= -->
        <Grid Grid.Column="2" Margin="10,0,0,-14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поля контакта -->
            <controls:ContactControl 
        DataContext="{Binding}"
        Margin="0,10,10,0"
        Grid.RowSpan="2"
        VerticalAlignment="Top"/>
        </Grid>

        <!-- Apply (скрыт по умолчанию) -->
        <Button Grid.Column="2"
                    Content="Apply"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                    Name="Apply_Button" Height="25"
                    Command="{Binding ApplyContact}"
                    Margin="140,180,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="75"/>
        <StackPanel Grid.Column="2"/>
    </Grid>
</Window>
