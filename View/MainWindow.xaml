<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" Height="450" Width="800"
        ResizeMode="NoResize">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="250" MaxWidth="430"/>
            <!-- Левая панель -->
            <ColumnDefinition Width="5"/>
            <!-- Сплиттер -->
            <ColumnDefinition/>
            <!-- Правая панель -->
        </Grid.ColumnDefinitions>

        <!-- ============= ЛЕВАЯ ПАНЕЛЬ ============= -->
        <Grid Grid.Column="0" Background="#f8f8f8" Margin="-15,-14,0,-14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поиск -->
            <StackPanel Orientation="Horizontal" 
                        Margin="15,15,10,0" 
                        Grid.RowSpan="2" 
                        Height="20" 
                        VerticalAlignment="Top"
                        Grid.Row="1">
                <Label Content="Find:" VerticalAlignment="Center" Height="25"/>
                <TextBox Grid.Column="1" Margin="5,0,0,0" Width="195"/>
            </StackPanel>

            <!-- Список контактов -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact}"
                     Margin="15,46,15,40"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Height="25" VerticalAlignment="Bottom" Margin="15,0,15,10">
                <Button Content="Add" Width="75" Margin="0,0,5,0"/>
                <Button Content="Edit" Width="75" Margin="0,0,5,0"/>
                <Button Content="Remove" Width="75"/>
            </StackPanel>
        </Grid>

        <!-- ============= СПЛИТТЕР ============= -->
        <GridSplitter
                      HorizontalAlignment="Stretch"
                      Background="#FFFFFF" Grid.Column="1"/>

        <!-- ============= ПРАВАЯ ПАНЕЛЬ ============= -->
        <Grid Grid.Column="2" Margin="10,0,0,-14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Фото -->
            <Image Source="/free-icon-person-14102739.png" Margin="5,10,0,0" Grid.RowSpan="2" Height="151" VerticalAlignment="Top" HorizontalAlignment="Left" Width="149"/>

            <!-- Поля контакта -->
            <StackPanel Margin="159,10,0,0" 
                        Grid.RowSpan="2" 
                        Height="139" 
                        VerticalAlignment="Top" >

                <Label Content="Name:"/>
                <TextBox Text="{Binding SelectedContact.Name}"
                         IsReadOnly="True"/>

                <Label Content="Phone Number:"/>
                <TextBox Text="{Binding SelectedContact.PhoneNumber}"
                         IsReadOnly="True"/>

                <Label Content="Email:"/>
                <TextBox Text="{Binding SelectedContact.Email}"
                         IsReadOnly="True"/>
            </StackPanel>

            <!-- Apply (скрыт по умолчанию) -->
            <Button Content="Apply"
                    Grid.Row="2"
                    Width="75" Height="25"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Command="{Binding ApplyCommand}"
                    Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>
